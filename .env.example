# Copy to .env and fill in. Never commit .env.

# --- required secrets ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
LK_SECRET_KEY=
# Bootstrap account, created only when the database has no users. At least 12 characters.
LK_ADMIN_USERNAME=keeper
LK_ADMIN_PASSWORD=password

# --- network ------------------------------------------------------------------
# The web UI binds to 127.0.0.1 only. Set true once you serve it over HTTPS.
LK_COOKIE_SECURE=false
LK_WEB_PORT=3000

# --- documents ----------------------------------------------------------------
LK_MAX_UPLOAD_MB=50
LK_MAX_PAGES=400
# tesseract (installed in the image) or none
LK_OCR_ENGINE=tesseract

# --- AI provider --------------------------------------------------------------
# fake: deterministic offline interpreter/narrator; nothing leaves the server.
# openai_compatible: any OpenAI-compatible Chat Completions endpoint (Ollama, llama.cpp, LM Studio, vLLM, hosted).
LK_AI_PROVIDER=fake
# Example local endpoint: http://host.docker.internal:11434/v1  (Ollama on the host)
LK_AI_BASE_URL=
LK_AI_API_KEY=
LK_AI_MODEL=local-model
# Remote endpoints are refused unless this is true. When true, player input, campaign state and
# approved adventure excerpts are transmitted to that service. Read docs/licensing-review.md first.
LK_AI_ALLOW_REMOTE=false

# Private rules profiles (*.profile.json) built from your own rulebook. Mounted read-only.
LK_RULES_PROFILE_HOST_DIR=../private/profiles

LK_LOG_LEVEL=INFO
