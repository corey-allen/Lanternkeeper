# Local scratch and tooling
.scratch/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Secrets and local configuration
.env
.env.*
!.env.example

# Runtime data: never commit uploaded documents, derived artifacts, or databases
data/
storage/
backups/
*.sqlite
*.db

# Owner-supplied rulebooks, adventures, private rules profiles and notes. NEVER commit.
# scripts/check_private_content.py fails if anything here is tracked.
private/

# Source documents. Only original synthetic fixtures under fixtures/ may be committed.
*.pdf
!fixtures/synthetic_adventures/*.pdf

# Owner's design document is kept locally (see docs/README.md)
*.docx

# Web
node_modules/
.next/
apps/web/out/
apps/web/test-results/
apps/web/playwright-report/
*.tsbuildinfo
next-env.d.ts
